Recomputation of anomaly counts (strict absolute threshold 1 second, not a count of clock adjustments):
from datetime import datetime
import json
from pathlib import Path
samples=[json.loads(x) for x in Path('docs/validation/m4-diagnostic-02-r1.jsonl').read_text().splitlines() if json.loads(x)['type']=='sample']
delta=lambda a,b:(datetime.fromisoformat(b)-datetime.fromisoformat(a)).total_seconds()
within=[r['id'] for r in samples if abs(delta(r['utc_start'],r['utc_end'])-(r['mono_end_ns']-r['mono_start_ns'])/1e9)>1]
backsteps=[(a['id'],b['id']) for a,b in zip(samples,samples[1:]) if b['utc_start']<a['utc_start']]
print(len(within),len(backsteps))  # actual archived result: 146,11
