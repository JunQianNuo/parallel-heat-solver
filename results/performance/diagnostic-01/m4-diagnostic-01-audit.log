for p in original:assert Path(p).read_bytes()==subprocess.check_output(['git','show','7c9ea09:'+p]),p
print(f'PASS: {len(original)} original source/script/test/performance/validation files byte-identical to 7c9ea09')
oldhash=subprocess.run(['sha256sum','-c','SHA256SUMS'],cwd='docs/performance',capture_output=True,text=True,check=True)
print(oldhash.stdout.strip())
paths=sorted(p for p in Path('docs/sources').rglob('*') if p.is_file())
