from pathlib import Path
import collections,hashlib,json,subprocess,sys
sys.path.insert(0,'scripts')
from analyze_diagnostics import analyze

prefix=Path('docs/validation/m4-diagnostic-01')
manifest=json.loads(Path(str(prefix)+'.json').read_text())
assert manifest['complete'] and manifest['source_and_binary_unchanged']
rows=[json.loads(x) for x in Path(str(prefix)+'.jsonl').read_text().splitlines()]
attempts=[r for r in rows if r.get('type')=='attempt']
samples=[r for r in rows if r.get('type')=='sample']
assert len(attempts)==len(samples)==manifest['invocations']
assert {r['id'] for r in attempts}=={r['id'] for r in samples}==set(range(len(samples)))
assert all(r['returncode']==0 for r in attempts)
for a,b in zip(attempts,samples):
    for key in a:
        if key!='type':assert a[key]==b[key], (a['id'],key)
assert all(a['mono_end_ns']<=b['mono_start_ns'] for a,b in zip(samples,samples[1:]))
assert sum(not r['warmup'] for r in samples)==manifest['measured']
assert sum(r['warmup'] for r in samples)==manifest['warmup_invocations']
repro=[r for r in samples if r['stage']=='reproduce']
counts=collections.Counter(json.dumps(r['config'],sort_keys=True) for r in repro)
assert len(counts)==23 and set(counts.values())=={10} and len(repro)==230
pairs=collections.defaultdict(list)
for r in rows:
    if r.get('type')=='comparison' and r['stage']!='cpu':
        assert len(r['a'])==len(r['b'])==10
        order=[a<b for a,b in zip(r['a'],r['b'])]
        assert sum(order)==5
        for a,b in zip(r['a'],r['b']):assert abs(a-b)==1
for r in samples:
    c=r['config']
    if c['variant']!='baseline':
        assert len(r['workers'])==c['p']
        assert sum(w['rows'] for w in r['workers'])==c['N']-1
        assert {w['id'] for w in r['workers']}==set(range(c['p']))
        assert all(w['cpu']==c['cpus'][w['id']] for w in r['workers'])
    if r['warmup']:assert r['validation']['E_inf']<=r['validation']['truncation_bound']
digest=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
assert all(digest(p)==v for p,v in manifest['source_sha256'].items())
assert all(digest(Path('build/m4-diagnostic-release')/('heat_'+k+'_diag'))==v for k,v in manifest['binary_sha256'].items())
print('PASS: complete attempts/samples, sequential monotonic timeline, counts, 23x10 reproduction, balanced adjacent pairs, workers, source/binary identity')
print(json.dumps({k:manifest[k] for k in ('revision','invocations','measured','warmup_invocations','source_and_binary_unchanged')},indent=2))
print('Measured stage counts:',dict(collections.Counter(r['stage'] for r in samples if not r['warmup'])))
result,effects=analyze(prefix,Path('build/m4-diagnostic-recomputed'),False)
for suffix in ('.csv','-workers.csv'):
    assert Path(str(prefix)+suffix).read_bytes()==Path('build/m4-diagnostic-recomputed'+suffix).read_bytes()
print(f'PASS: byte-identical regenerated statistics; {len(result)} configuration groups, {len(effects)} comparisons')
before={p:digest(p) for p in prefix.parent.glob(prefix.name+'*') if p.is_file()}
rerun=subprocess.run([sys.executable,'scripts/diagnose.py','--build','build/m4-diagnostic-release','--run-id','01'],capture_output=True,text=True)
assert rerun.returncode!=0 and 'run ID already exists' in rerun.stderr
assert before=={p:digest(p) for p in before}
print('PASS: repeated run ID rejected before writing; existing artifact hashes unchanged')
