#include <omp.h>
#include <cstdio>
int main() {
 printf("_OPENMP=%d procs=%d max=%d limit=%d dynamic=%d\n",_OPENMP,omp_get_num_procs(),omp_get_max_threads(),omp_get_thread_limit(),omp_get_dynamic());
 omp_set_dynamic(0);
 for(int q=1;q<=4;++q) {
  #pragma omp parallel num_threads(q)
  {
   #pragma omp single
   printf("requested=%d actual=%d\n",q,omp_get_num_threads());
  }
 }
}

#include <omp.h>
#include <cstdio>
#include <initializer_list>
int main() {
 omp_set_dynamic(0);
 for(int q=1;q<=4;++q) for(int n: {2,7}) {
  int owners[7]={}; int actual=0;
  #pragma omp parallel num_threads(q) shared(owners,actual)
  {
   #pragma omp single
   actual=omp_get_num_threads();
   #pragma omp for schedule(static,1)
   for(int i=1;i<n;++i) owners[i]=omp_get_thread_num();
  }
  printf("N=%d requested=%d actual=%d row:thread",n,q,actual);
  for(int i=1;i<n;++i) printf(" %d:%d",i,owners[i]);
  puts("");
 }
}

